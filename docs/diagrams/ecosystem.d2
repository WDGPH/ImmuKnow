...@style
# Explicit cells keep ownership and file handoffs aligned at prose-column width.
grid-rows: 3
grid-columns: 3
horizontal-gap: 32
vertical-gap: 48

template: {
  accent
  inset
  ...${card}
  content: |md
    **ImmuKnow Template**

    Notices, settings, references
  |
}
resources: {
  accent
  inset
  ...${card}
  accent.style.fill: '#78716c'
  content: |md
    **Core library + schemas**

    Copy intact at project setup
  |
}
upstream: {
  accent
  inset
  ...${card}
  accent.style.fill: '#78716c'
  content: |md
    **Upstream system**

    Assesses immunization status
  |
}
studio: {
  accent
  inset
  ...${card}
  content: |md
    **ImmuKnow Studio**

    Browser editing + previews
  |
}
project: {
  accent
  inset
  ...${card}
  accent.style.fill: '#2563eb'
  content: |md
    **Authored project**

    Templates, config, branding
  |
}
input: {
  accent
  inset
  ...${card}
  accent.style.fill: '#78716c'
  content: |md
    **CSV + notice selections**

    Supplied facts and choices
  |
}
space7: ${blank}
core: {
  accent
  inset
  ...${card}
  content: |md
    **ImmuKnow Core**

    Native production processing
  |
}
outputs: {
  accent
  inset
  ...${card}
  accent.style.fill: '#78716c'
  content: |md
    **PDFs, bundles, reports**

    Review before delivery
  |
}

template -> project: starter files {class: flow}
resources -> project: {class: flow}
upstream -> input: {class: flow}
studio <-> project: {class: flow}
project -> core: {class: flow}
input -> core: {class: flow}
core -> outputs: {class: flow}
