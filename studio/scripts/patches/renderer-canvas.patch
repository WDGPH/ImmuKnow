+impl Drop for LazyImage {
+    fn drop(&mut self) {
+        if Arc::strong_count(&self.loaded) != 1 {
+            return;
+        }
+        let Some(loaded) = self.loaded.lock().unwrap().take() else {
+            return;
+        };
+        if let Some(bitmap) = loaded.dyn_ref::<web_sys::ImageBitmap>() {
+            bitmap.close();
+        } else if let Some(canvas) = loaded.dyn_ref::<OffscreenCanvas>() {
+            canvas.set_width(0);
+            canvas.set_height(0);
+        }
+    }
+}
