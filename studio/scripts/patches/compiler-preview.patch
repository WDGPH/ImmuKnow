+    /// Page geometry and ordinary text positions from the compiled paged layout.
+    /// Text in transformed groups remains available to accessibility readers,
+    /// but is omitted from hit targets when its position cannot be represented
+    /// by an axis-aligned box.
+    pub fn preview_info(&self) -> Result<String, JsValue> {
+        let doc = self
+            .get_doc_t::<TypstPagedDocument>()?
+            .ok_or_else(|| error_once!("document is not compiled"))?;
+        let pages = doc
+            .pages()
+            .iter()
+            .map(|page| {
+                let mut text = Vec::new();
+                let mut plain_text = Vec::new();
+                collect_preview_text(
+                    &page.frame,
+                    ::typst::layout::Point::zero(),
+                    true,
+                    &mut text,
+                    &mut plain_text,
+                );
+                serde_json::json!({
+                    "width": page.frame.size().x.to_pt(),
+                    "height": page.frame.size().y.to_pt(),
+                    "text": text,
+                    "plainText": plain_text.join("\n"),
+                })
+            })
+            .collect::<Vec<_>>();
+        serde_json::to_string(&serde_json::json!({ "pages": pages }))
+            .map_err(|error| JsValue::from_str(&error.to_string()))
+    }
