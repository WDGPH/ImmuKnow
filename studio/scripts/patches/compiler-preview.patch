+fn collect_preview_text(
+    frame: &::typst::layout::Frame,
+    origin: ::typst::layout::Point,
+    positioned: bool,
+    text: &mut Vec<serde_json::Value>,
+    plain_text: &mut Vec<String>,
+) {
+    use ::typst::layout::{FrameItem, Point};
+
+    for (position, item) in frame.items() {
+        let position = origin + *position;
+        match item {
+            FrameItem::Text(run) => {
+                if run.text.is_empty() {
+                    continue;
+                }
+                plain_text.push(run.text.to_string());
+                if !positioned {
+                    continue;
+                }
+                let bounds = run.bbox();
+                let x0 = (position.x + bounds.min.x).to_pt();
+                let x1 = (position.x + bounds.max.x).to_pt();
+                let y0 = (position.y + bounds.min.y).to_pt();
+                let y1 = (position.y + bounds.max.y).to_pt();
+                let x = x0.min(x1);
+                let y = y0.min(y1);
+                let width = (x1 - x0).abs();
+                let height = (y1 - y0).abs();
+                if x.is_finite() && y.is_finite() && width > 0.0 && height > 0.0 {
+                    text.push(serde_json::json!({
+                        "text": run.text.as_str(), "x": x, "y": y,
+                        "width": width, "height": height,
+                    }));
+                }
+            }
+            FrameItem::Group(group) => {
+                let movable = group.transform.is_only_translate();
+                let offset = Point::new(group.transform.tx, group.transform.ty);
+                collect_preview_text(
+                    &group.frame,
+                    position + offset,
+                    positioned && movable,
+                    text,
+                    plain_text,
+                );
+            }
+            _ => {}
+        }
+    }
+}
